<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="mrp_cut_plan_purchase" inherit_id="purchase.report_purchaseorder_document">

            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.external_layout">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <t t-set="address">
                    </t>

                    <div class="page">
                        <div style="position: relative; min-height: 24px;">
                            <t t-if="o.state == 'draft'">
                                <h5 style="margin: 0;">
                                    <b>Cotação:</b> <span t-field="o.name"/>
                                </h5>
                            </t>
                            <t t-if="o.state in ['sent', 'to approve']">
                                <h5 style="margin: 0;">
                                    <b>Pedido Aguardando Confirmação:</b> <span t-field="o.name"/>
                                </h5>
                            </t>
                            <t t-if="o.state in ['purchase', 'done']">
                                <h5 style="margin: 0;">
                                    <b>Pedido de Compra:</b> <span t-field="o.name"/>
                                </h5>
                            </t>
                            <t t-if="o.state == 'cancel'">
                                <h5 style="margin: 0;">
                                    <b>Pedido de Compra Cancelado:</b> <span t-field="o.name"/>
                                </h5>
                            </t>

                            <!-- Dt. Pedido sempre à direita -->
                            <div style="position: absolute; right: 0; top: 0;">
                                <b>Dt. Pedido: </b><span t-field="o.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                            </div>
                        </div>

                        <br/>
                        <table class="table table-sm o_main_table">
                            <tr>
                                <td style="vertical-align: middle;">
                                    <div class="oe_structure"/>
                                    <h5 t-if="o.partner_id.name"><strong><span t-field="o.partner_id.name"/></strong><br/></h5>
                                </td>
                                <td style="vertical-align: middle;">

                                    <div t-if="o.partner_ref" class="m-0">
                                        <strong>Referencia: </strong><span t-field="o.partner_ref" class="m-0"/>
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <!-- <strong>Fornecedor: </strong><span t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;street&quot;, &quot;name&quot;, &quot;email&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" /> -->
                                    <strong>Comprador(a): </strong><span t-field="o.user_id" t-options="{&quot;fields&quot;: [&quot;name&quot;]}" class="m-0"/><br/><br/>
                                    <strong>E-mail: </strong><span t-field="o.user_id.email" class="m-0"/>
                                </td>
                            </tr>
                            <tr>

                                <t t-if="o.dest_address_id">
                                    <t t-set="information_block">
                                        <strong>Shipping address:</strong>
                                        <div t-if="o.dest_address_id">
                                            <div t-field="o.dest_address_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;address2&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" name="purchase_shipping_address"/>
                                        </div>
                                    </t>
                                </t>
                                <td>
                                    <strong>Endereço: </strong>
                                    <div>

                                        <t t-if="o.partner_id.street"> <t t-esc="o.partner_id.street"/></t><br/>
                                        <t t-if="o.partner_id.street2">Compl: <t t-esc="o.partner_id.street2"/><br/></t>
                                        <t t-if="o.partner_id.district">Bairro: <t t-esc="o.partner_id.district"/><br/></t>
                                        <t t-if="o.partner_id.zip or o.partner_id.city">
                                            <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/></t>
                                            <t t-if="o.partner_id.state_id"> - <t t-esc="o.partner_id.state_id.code"/> - </t>
                                        </t>
                                        <t t-if="o.partner_id.country_id"><t t-esc="o.partner_id.country_id.name"/> - </t>
                                        <t t-if="o.partner_id.zip">CEP: <t t-esc="o.partner_id.zip"/> </t>
                                    </div>


                                </td>

                                <td style="vertical-align: middle;">
                                    <strong>Frete: </strong><span t-field="o.incoterm_id.code" class="m-0"/><br/>
                                    <div>
                                        <strong>Consumo final: </strong><span t-field="o.ind_final" class="m-0"/>
                                    </div>
                                </td>
                                <td style="vertical-align: middle;">
                                    <div t-if="o.payment_term_id">
                                        <b>Prazo: </b><span t-field="o.payment_term_id" class="m-0"/>
                                    </div>
                                    <span class="m-0"><strong>Pagamento: </strong></span><span t-field="o.payment_mode_id.name" class="m-0"/><br/>

                                    <div t-if="o.chave_pix">

                                        <span class="m-0"><strong>Tipo: </strong></span><span t-field="o.chave_pix.key_type" class="m-0" t-options="{&quot;fields&quot;: [&quot;key_type&quot;]}"/><br/>
                                        <span class="m-0"><strong>Chave: </strong></span><span t-field="o.chave_pix.key" class="m-0" t-options="{&quot;fields&quot;: [&quot;key&quot;]}"/>

                                    </div>
                                </td>

                            </tr>
                        </table>
                        <div id="informations" class="row mt5 mb5"/>
                        <table class="table table-sm o_main_table">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th name="th_description" class="text-center"><strong>Description</strong></th>
                                    <th name="th_date_req" class="text-center"><strong>Entrega</strong></th>
                                    <th name="th_quantity" class="text-center"><strong>Qty</strong></th>
                                    <th name="th_price_unit" class="text-center"><strong>P.Unit</strong></th>

                                    <t t-set="has_icms" t-value="any(line.icms_percent for line in o.order_line if not line.display_type)"/>
                                    <t t-if="has_icms">
                                        <th name="th_icms_percent" class="text-center"><strong>Icms</strong></th>
                                    </t>

                                    <t t-set="has_ipi" t-value="any(line.ipi_percent for line in o.order_line if not line.display_type)"/>
                                    <t t-if="has_ipi">
                                        <th name="th_ipi_percent" class="text-center"><strong>Ipi</strong></th>
                                    </t>

                                    <t t-set="has_discount" t-value="any(line.discount for line in o.order_line if not line.display_type)"/>
                                    <t t-if="has_discount">
                                        <th name="th_discount" class="text-center"><strong>Desc.%</strong></th>
                                    </t>
                                    <th name="th_amount" class="text-center"><strong>Amount</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-foreach="o.order_line" t-as="line">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                                    <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                        <t t-if="not line.display_type">

                                            <td id="product">
                                                <span t-field="line.name"/>
                                            </td>

                                            <td class="text-center">
                                                <span t-field="line.date_planned" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-field="line.product_qty"/>
                                                <!--<t t-set="product_qty" t-value="line.product_qty"/>-->


                                                <!--<t t-set="rounded_2_raw" t-value="'{:,.2f}'.format(product_qty)"/>-->
                                                <!--<t t-set="rounded_5_raw" t-value="'{:,.5f}'.format(product_qty)"/>-->

                                                <!--<t t-set="rounded_2" t-value="rounded_2_raw.replace(',', 'X').replace('.', ',').replace('X', '.')"/>-->
                                                <!--<t t-set="rounded_5" t-value="rounded_5_raw.replace(',', 'X').replace('.', ',').replace('X', '.')"/>-->

                                                <!--<t t-set="product_qty" t-value="rounded_5 if float(product_qty) != round(product_qty, 2) else rounded_2"/>-->
                                                <!--<span t-esc="product_qty"/>-->
                                                <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                            </td>

                                            <td class="text-center">
                                                <!--<span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;display_currency&quot;: o.currency_id}"/>-->
                                                <t t-set="unit_price" t-value="line.price_unit"/>
                                                <t t-set="currency_symbol" t-value="o.currency_id.symbol"/>

                                                <t t-set="rounded_2_raw" t-value="'{:,.2f}'.format(unit_price)"/>
                                                <t t-set="rounded_5_raw" t-value="'{:,.5f}'.format(unit_price)"/>

                                                <t t-set="rounded_2" t-value="rounded_2_raw.replace(',', 'X').replace('.', ',').replace('X', '.')"/>
                                                <t t-set="rounded_5" t-value="rounded_5_raw.replace(',', 'X').replace('.', ',').replace('X', '.')"/>

                                                <t t-set="display_price" t-value="rounded_5 if float(unit_price) != round(unit_price, 2) else rounded_2"/>

                                                <span t-esc="currency_symbol + ' ' + display_price"/>


                                            </td>


                                            <t t-if="has_icms">
                                                <td class="text-center">
                                                    <t t-if="line.icms_percent">
                                                        <span t-field="line.icms_percent"/>%
                                                    </t>
                                                    <t t-else="">
                                                        0%
                                                    </t>
                                                </td>
                                            </t>

                                            <t t-if="has_ipi">
                                                <td class="text-center">
                                                    <t t-if="line.ipi_percent">
                                                        <span t-field="line.ipi_percent"/>%
                                                    </t>
                                                    <t t-else="">
                                                        0%
                                                    </t>
                                                </td>
                                            </t>

                                            <t t-if="line.discount">
                                                <td class="text-center">
                                                    <span t-field="line.discount" t-options="{'widget': 'percentage'}"/>
                                                </td>
                                            </t>
                                            <td class="text-end">
                                                <span t-field="line.price_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </t>
                                        <t t-if="line.display_type == 'line_section'">
                                            <td colspan="99" id="section">
                                                <span t-field="line.name"/>
                                            </td>
                                            <t t-set="current_section" t-value="line"/>
                                            <t t-set="current_subtotal" t-value="0"/>
                                        </t>
                                        <t t-if="line.display_type == 'line_note'">
                                            <td colspan="99" id="note">
                                                <span t-field="line.name"/>
                                            </td>
                                        </t>
                                    </tr>

                                </t>
                            </tbody>
                        </table>
                        <div id="total" class="row justify-content-end">
                            <div class="col-4">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Total Bruto</td>
                                        <td class="text-end">
                                            <span t-field="o.amount_price_gross" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                    <t t-if="has_discount">
                                        <tr>
                                            <td>Discount</td>
                                            <td class="text-end">
                                                <span t-field="o.amount_discount_value" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="o.amount_icms_value">
                                        <tr>
                                            <td>ICMS</td>
                                            <td class="text-end">
                                                <span t-field="o.amount_icms_value" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="o.amount_ipi_value">
                                        <tr>
                                            <td>IPI</td>
                                            <td class="text-end">
                                                <span t-field="o.amount_ipi_value" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>



                                    <tr class="border-black o_total">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <p t-field="o.notes"/>
                        <div class="oe_structure"/>
                    </div>
                </t>

            </xpath>

        </template>

    </data>
</odoo>
