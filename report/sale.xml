<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <template id="report_saleorder_document_os" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">

    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="address">

        </t>

        <div class="page">
            <div class="oe_structure"/>

             <h5 class="mt16">
                <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                    <span t-if="doc.state not in ['draft','sent']">Pedido de Venda - </span>
                    <span t-if="doc.state in ['draft','sent']">Cotação - </span>
                </t>
                <t t-if="env.context.get('proforma', False) or is_pro_forma">
                    <span>Pro-Forma Invoice # </span>
                </t>
                <strong><span t-field="doc.name"/></strong>
            </h5>

            <table class="table table-sm o_main_table">

                 <tr>
                    <td>
                        <span><t t-if="doc.partner_id.parent_id.name"/><b><t t-esc="doc.partner_id.parent_id.name"/></b></span>
                        <br/>
                         <div>

                            <t t-if="doc.partner_id.parent_id.street"> <t t-esc="doc.partner_id.street"/></t><br/>
                            <t t-if="doc.partner_id.parent_id.street2">Compl: <t t-esc="doc.partner_id.street2"/><br/></t>
                            <t t-if="doc.partner_id.parent_id.district">Bairro: <t t-esc="doc.partner_id.district"/><br/></t>
                            <t t-if="doc.partner_id.parent_id.zip or doc.partner_id.parent_id.city">
                              <t t-if="doc.partner_id.parent_id.city"><t t-esc="doc.partner_id.parent_id.city"/></t>
                              <t t-if="doc.partner_id.parent_id.state_id"> - <t t-esc="doc.partner_id.parent_id.state_id.code"/> - </t>
                            </t>
                            <t t-if="doc.partner_id.parent_id.country_id"><t t-esc="doc.partner_id.parent_id.country_id.name"/> - </t>
                            <t t-if="doc.partner_id.parent_id.zip">CEP: <t t-esc="doc.partner_id.parent_id.zip"/> </t>
                        </div>
                    </td>
                        <!-- <div t-field="doc.partner_id.parent_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;name&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}" /></td> -->
                    <td><strong>Contato: </strong><span t-field="doc.partner_id.name"/><div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;contact&quot;,&quot;email&quot;, &quot;phone&quot;, &quot;mobile&quot;], &quot;no_marker&quot;: False, &quot;phone_icons&quot;: True}"/></td>
                </tr>
                <br/>
                <span class="m-0"><h6>Prezado Sr(a).: </h6></span><h6><strong><div class="m-0" t-field="doc.partner_id.name"/></strong></h6> <span><h6>Conforme vossa solicitação apresentamos nossa proposta.</h6></span><br/>
                <div class="row mt32 mb32" id="informations">



                     <div t-if="doc.date_order and doc.state not in ['draft','sent']" class="col-auto col-3 mw-200 mb-2">
                        <strong>Data do Pedido: </strong>
                        <span class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                    </div>

                    <div t-if="doc.date_order and doc.state in ['draft','sent']" class="col-auto col-3 mw-200 mb-2">
                        <strong>Data da Cotação: </strong>
                        <span class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                    </div>



                     <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col-auto col-3 mw-200 mb-2" name="expiration_date">
                        <strong>Válida até: </strong>
                        <span class="m-0" t-field="doc.validity_date"/>
                    </div>


                          <div t-if="doc.commitment_date" class="col-auto col-3 mw-100 mb-2" name="commitment">
                              <strong>Entrega: </strong>
                              <span class="m-0" t-field="doc.commitment_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                          </div>



                          <div t-if="doc.client_order_ref" class="col-auto col-3 mw-100 mb-2" name="reference">
                              <strong>Sua referência: </strong>
                              <span class="m-0" t-field="doc.client_order_ref"/>
                          </div>



                          <div t-if="doc.payment_term_id" class="col-auto col-3 mw-100 mb-2" name="payment_term_id">
                              <strong>Pagamento: </strong>
                              <span class="m-0" t-field="doc.payment_term_id"/>
                          </div>


            </div>

            </table>

            <!-- Is there a discount on at least one line? -->
            <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>
            <t t-set="icms_percent" t-value="any(l.icms_percent for l in doc.order_line)"/>
            <t t-set="ipi_percent" t-value="any(l.ipi_percent for l in doc.order_line)"/>

            <table class="table table-sm o_main_table">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group">
                    <tr>
                        <th name="th_description" class="text-center">Descrição</th>
                        <th name="th_quantity" class="text-center">Qtd</th>
                        <th name="th_priceunit" class="text-center">Preço Unit.</th>
                        <th name="th_discount" t-if="display_discount" class="text-center" groups="product.group_discount_per_so_line">
                            <span>Desc.%</span>
                        </th>

<!--                        <th name="th_icms_percent" t-if="icms_percent" class="text-center">ICMS</th>-->
                        <!--<th name="th_ipi_percent" t-if="ipi_percent" class="text-center" style="width: 40px;">IPI</th>-->
                        <th name="th_subtotal" class="text-center">
                            <span groups="account.group_show_line_subtotals_tax_excluded">Total</span>
                            <span groups="account.group_show_line_subtotals_tax_included">Total</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">

                    <t t-set="current_subtotal" t-value="0"/>

                    <t t-foreach="doc.order_line" t-as="line">

                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td name="td_name"><span t-field="line.name"/></td>
                                <td name="td_quantity" class="text-center">
                                                      <!-- <span t-field="line.product_qty"/> -->
                                    <t t-set="product_qty" t-value="line.product_uom_qty"/>
<t t-set="rounded_2_raw" t-value="'{:,.2f}'.format(product_qty)"/>
<t t-set="rounded_5_raw" t-value="'{:,.5f}'.format(product_qty)"/>

<t t-set="rounded_2" t-value="rounded_2_raw.replace(',', 'X').replace('.', ',').replace('X', '.')"/>
<t t-set="rounded_5" t-value="rounded_5_raw.replace(',', 'X').replace('.', ',').replace('X', '.')"/>

<t t-set="product_qty_formatted" t-value="rounded_5 if float(product_qty) != round(product_qty, 4) else rounded_2"/>
<span t-esc="product_qty_formatted"/>
<span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                </td>

                                <td name="td_priceunit" class="text-end">
                                    <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: line.currency_id}"/>
                                </td>
                                <td name="td_display_discount" t-if="display_discount" class="text-end" groups="product.group_discount_per_so_line">
                                    <span t-field="line.discount"/>
                                </td>

<!--                                <td t-if="line.icms_percent" class="text-end">-->
<!--                                  <span t-esc="'%.0f %' % (line.icms_percent)"/>-->
<!--                                </td>-->

                                <!--<td name="td_ipi_percent" class="text-end">
                                  <span t-esc="'%.0f %' % (line.ipi_percent)"/>
                                </td>-->

                               <td name="td_subtotal" class="text-end o_price_total">
                                    <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                </td>
                            </t>




                            <t t-if="line.display_type == 'line_section'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>

                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td name="td_note_line" colspan="99">
                                    <span t-field="line.name"/>
                                </td>
                            </t>
                        </tr>

                        <!--<t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span
                                        t-esc="current_subtotal"
                                        t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                                    />
                                </td>
                            </tr>
                        </t>-->
                    </t>
                </tbody>
            </table>

            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row text-end float-end" name="total">
                    <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">
                        <table class="table table-sm">
                            <tr class="border-black o_subtotal" style="">
                                <td name="td_amount_untaxed_label"><strong>Subtotal</strong></td>
                                <td name="td_amount_untaxed" class="text-end">
                                    <span t-field="doc.amount_untaxed"/>
                                </td>

                            </tr>


                          <tr class="border-black o_subtotal" style="">
                                <td name="icms">ICMS</td>
                                <td name="amount_icms" class="text-end o_price_total">
                                 <span t-field="doc.amount_icms_value"/>
                                 </td>
                          </tr>
                          <t t-if="doc.amount_ipi_value">
                          <tr>
                                  <td name="ipi">IPI</td>
                                  <td name="amount_ipi" class="text-end o_price_total">
                                 <span t-field="doc.amount_ipi_value"/>
                                 </td>
                                </tr>
                          </t>

                          <!-- <tr class="border-black o_subtotal" style="">
                                <td name="amount_tax">Impostos</td>
                                <td name="taxes" class="text-end o_price_total">
                                  <span t-field="doc.amount_tax"/>
                                </td>
                                </tr> -->


                            <tr class="border-black o_total">
                                <td name="td_amount_total_label"><strong>Total</strong></td>
                                <td name="td_amount_total" class="text-end">
                                    <span t-field="doc.amount_total"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
          <br/>
            <div t-if="doc.signature" class="mt32 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <p t-field="doc.signed_by"/>
                </div>

            </div>


            <div class="oe_structure"/>

            <p t-field="doc.note"/>
            <!--<p t-if="doc.payment_term_id.note">
                <span t-field="doc.payment_term_id.note"/>
            </p>-->
            <p id="fiscal_position_remark" t-if="doc.fiscal_position_id and doc.fiscal_position_id.sudo().note">
                <strong>Fiscal Position Remark:</strong>
                <span t-field="doc.fiscal_position_id.sudo().note"/>
            </p>
<!--              <p t-if="doc.payment_term_id.note">-->
<!--                <span t-field="doc.payment_term_id.note"/>-->
<!--            </p>-->
            <br/>
            <div class="last-page">
              <div class="mt32 m164 mr4" name="contato">

                <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                    <span>Atenciosamente,</span><br/><br/>
                    <strong><i><span t-field="doc.user_id"/></i></strong>
                    <br/>
                    <strong>E-mail: </strong><span t-field="doc.user_id.email" t-options="{&quot;widget&quot;: &quot;email&quot;}"/>
                    <br/>
                    <strong>Telefone: </strong>
                    <span class="m-0" t-field="doc.user_id.mobile"/>
                </div>
              </div>
            </div>
        </div>
    </t>



    </xpath>
    </template>
    </data>
</odoo>
