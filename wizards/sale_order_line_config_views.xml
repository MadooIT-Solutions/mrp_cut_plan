<?xml version='1.0' encoding='utf-8'?>
<odoo>    
    
    <record id="sale_order_line_prod_config_view_form" model="ir.ui.view">
        <field name="name">sale.order.line.prod.config.form</field>
        <field name="model">sale.order.line.config</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-danger" role="alert" style="margin-botton:0px;" attrs="{'invisible': ['|', ('template_price_config_id', '!=', False), ('related_type', '=', 'llh')]}">
                    <bold>Model price configuration not configured for this product: <field name="product_id"/></bold>
                </div>
                <sheet>
                     <group>
                        <group>
                                <field name="product_template_id"/>
                                <field name="quantity" options="{&quot;type&quot;: &quot;number&quot;, &quot;step&quot;:1}"/>
                                <field name="price_unit" widget="monetary" attrs="{'required': [('related_type', '=', 'llh')], 'invisible': [('related_type', '=', 'm')]}"/>
                                <field name="price_unit_m" widget="monetary" attrs="{'required': [('related_type', '=', 'm')], 'invisible': [('related_type', '=', 'llh')]}"/>
                                <field name="pricelist_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                        </group>

                            <group>
                                <field name="blue_m3_unit"/>
                                <field name="blue_m2_unit"/>
                          </group>

                        <group string="Dimentions">
                            <field name="blue_I" attrs="{'invisible': [('related_type', '!=', 'llh')], 'required': [('related_type', '=', 'llh')]}"/>
                            <field name="blue_II" attrs="{'invisible': [('related_type', '!=', 'llh')], 'required': [('related_type', '=', 'llh')]}"/>
                            <field name="blue_h" attrs="{'required': [('related_type', '!=', 'n')]}"/>
                            <field name="blue_advance" attrs="{'invisible': [('related_type', '!=', 'm')], 'required': [('related_type', '=', 'm')]}"/>
                            <field name="blue_wall" invisible="True"/>
                        </group>
                        <group string="UoM">
                            <field name="blue_I_uom" attrs="{'invisible': [('related_type', '!=', 'llh')], 'required': [('related_type', '=', 'llh')]}"/>
                            <field name="blue_II_uom" attrs="{'invisible': [('related_type', '!=', 'llh')], 'required': [('related_type', '=', 'llh')]}"/>
                            <field name="blue_h_uom" attrs="{'required': [('related_type', '!=', 'n')]}"/>
                            <field name="blue_advance_uom" attrs="{'invisible': [('related_type', '!=', 'm')], 'required': [('related_type', '=', 'm')]}"/>
                            <field name="blue_wall_uom" invisible="True"/>
                        </group>
                    </group>

                    <group string="Areas">
                        <group>
                            <field name="blue_m3"/>
                            <field name="blue_m2" />
                            <field name="blue_tela_cost" invisible="True"/>
                            <field name="blue_curve_cost" invisible="True" string="Custo Curva"/>
                            <field name="blue_eps_cost" invisible="True"/>
                            <field name="template_price_config_id" invisible="0"/>
                        </group>
                        <group>
                            <field name="price_total" widget="monetary"/>
                            <field name="related_type" invisible='True'/>
                        </group>
                    </group>

                </sheet>
                <footer>
                    <button string="Save" name="action_save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    
</odoo>