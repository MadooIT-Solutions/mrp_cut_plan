<odoo>
    <record id="view_mrp_production_transfer_wizard" model="ir.ui.view">
        <field name="name">mrp.production.transfer.wizard.form</field>
        <field name="model">mrp.production.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Selecionar Armazém de Destino">
                <sheet>
                    <group>
                        <group string="Ordem de Produção">

                            <field name="production_id" readonly="1" class="oe_inline"/>
                        </group>
                        <group string="Destino">
                            <field name="domain_location_ids" invisible="1"/>
                            <field name="location_dest_id" required="1" class="oe_inline" />
                            <field name="location_dest_warehouse_name" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        <b>Fluxo que será criado:</b><br/>
                        1. Envio para o armazém selecionado<br/>
                        2. Recebimento no armazém destino<br/>
                        3. Processamento no armazém destino<br/>
                        4. Retorno para matriz<br/>
                        5. Recebimento final e conclusão
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Iniciar Fluxo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mrp_production_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Selecionar Armazém de Destino</field>
        <field name="res_model">mrp.production.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'search_default_production_id': active_id}</field>
    </record>


</odoo>