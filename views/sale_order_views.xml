<odoo>
    <record id="sale_order_line_inherit_mrp_cut_plan" model="ir.ui.view">
        <field name="name">sale.order.line.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="open_linked_po" attrs="{'invisible': [('count_po', '=', 0)]}"
                    type="object" icon="fa-flask">
                    <div class="o_stat_info">
                        <field name="count_po" nolabel="1" widget="statinfo"/>
                        <span class="o_stat_text">Plano De Corte</span>
                    </div>
                </button>
            </xpath>




            <xpath expr="//notebook/page[@name='order_lines']//tree[1]/field[1]" position="after">
                <field name="related_blue_area_calc" invisible="1"/>
                <button name="button_configure_product"
                    class="btn-secondary"
                    type="object"
                    string="Configure"
                    attrs="{'invisible': ['|', ('related_blue_area_calc', '=', 'n'), ('related_blue_area_calc', '=', False)]}"
                />
            </xpath>


        </field>
    </record>

    <!-- VIEW PIVÔ HIERÁRQUICA -->
    <record id="view_sales_pivot_category_hierarchy" model="ir.ui.view">
        <field name="name">sale.order.line.pivot.category.hierarchy</field>
        <field name="model">sale.order.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <pivot string="Vendas por Categoria">
                <field name="categ_display_name" type="row"/>
                <field name="price_subtotal" type="measure" widget="monetary"/>
            </pivot>
        </field>
    </record>

    <!-- NOVA AÇÃO - NÃO SUBSTITUI A ORIGINAL -->
    <record id="action_report_sale_product_hierarchy" model="ir.actions.act_window">
        <field name="name">Análise de Produtos por Hierarquia</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_sales_pivot_category_hierarchy"/>
        <field name="context">{}</field>
    </record>

    <!-- MENU ITEM CORRIGIDO - aponta para a nova ação -->
    <menuitem id="menu_sale_report_hierarchy"
          name="Análise por Hierarquia"
          parent="sale.menu_sale_report"
          action="action_report_sale_product_hierarchy"
          sequence="50"/>
</odoo>