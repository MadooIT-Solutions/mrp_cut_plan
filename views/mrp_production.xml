<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- mrp_cut_plan - views/mrp_production.xml (versão revisada) -->

    <record id="mrp_cut_production_inherit" model="ir.ui.view">
        <field name="name">mrp.production.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Substitui header com controles seguros -->
            <xpath expr="//header" position="replace">
                <header>
                    <!-- Campos invisíveis usados em attrs/logic -->
                    <field name="show_lock" invisible="1"/>
                    <field name="is_locked" invisible="1"/>
                    <field name="confirm_cancel" invisible="1"/>
                    <field name="show_serial_mass_produce" invisible="1"/>

                    <field name="branch_location_id" invisible="1"/>
                    <field name="sending_transfer_id" invisible="1"/>
                    <field name="total_qty_received" invisible="1"/>
                    <field name="related_type" invisible="1"/>
                    <field name="origin_production_id" invisible="1"/>
                    <field name="is_planned" invisible="1"/>
                    <field name="product_qty" invisible="1"/>
                    <field name="product_id" invisible="1"/>
                    <field name="hide_check_availability" invisible="1"/>

                    <!-- Botões: attrs simples e seguros -->
                    <button name="button_send_to_branch" type="object" class="oe_highlight"
                            string="Send to Branch"
                            attrs="{'invisible': ['|','|',('related_type','!=','m'),('branch_location_id','!=',False),('state','in',['done'])]}"/>

                    <button name="action_confirm" type="object" class="oe_highlight" string="Confirm"
                            attrs="{'invisible':[('state','!=','draft')]}"/>
                    <button name="button_mark_done" type="object" class="oe_highlight" string="Validate"
                            attrs="{'invisible':[('state','not in',['progress','to_close','confirmed'])]}"/>

                    <button name="button_plan" type="object" class="oe_highlight" string="Plan"
                            attrs="{'invisible':['|','|','|',('state','not in',['confirmed','progress','to_close']),('workorder_ids','=',[]),('is_planned','=',True),('origin_production_id','!=',False)]}"/>

                    <button name="button_unplan"
                            type="object"
                            class="oe_highlight"
                            string="Unplan"
                            attrs="{'invisible': [
            '|', '|',
            ['is_planned', '=', False],
            ['state', '=', 'cancel'],
            ['origin_production_id', '!=', False],
            ['related_type', '=', 'm']
        ]}"/>

                    <button name="action_assign" type="object" string="Check Availability"
                            attrs="{'invisible':[('hide_check_availability','=',True)]}"/>

                    <button name="do_unreserve" type="object" string="Unreserve"
                            attrs="{'invisible':[('unreserve_visible','=',False)]}"/>

                    <button name="button_scrap" type="object" string="Scrap"
                            attrs="{'invisible':[('state','in',['cancel','draft'])]}"/>

                    <button name="action_toggle_is_locked" type="object" string="Unlock"
                            groups="mrp.group_mrp_manager"
                            attrs="{'invisible':[('show_lock','=',False),('is_locked','=',False)]}"/>

                    <button name="action_toggle_is_locked" type="object" string="Lock"
                            groups="mrp.group_mrp_manager"
                            attrs="{'invisible':[('show_lock','=',False),('is_locked','=',True)]}"/>

                    <button name="action_serial_mass_produce_wizard" type="object" string="Mass Produce"
                            attrs="{'invisible':[('show_serial_mass_produce','=',False)]}"/>

                    <button name="action_cancel" type="object" string="Cancel"
                            attrs="{'invisible':[('state','in',['done','cancel'])]}"
                            confirm="{'True':'Some product moves have already been confirmed. Are you sure?', 'False':''}[confirm_cancel]"/>

                    <button name="button_unbuild" type="object" string="Unbuild"
                            attrs="{'invisible':[('state','!=','done')]}"/>

                    <!-- Statusbar -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,progress,done"/>
                </header>
            </xpath>

            <!-- Fluxo filial: campos inseridos dentro do bloco onde product_id está -->
            <xpath expr="//group[field[@name='product_id']]" position="inside">
                <separator string="Fluxo Filial"/>
                <field name="origin_production_id" readonly="1"/>
                <field name="sending_transfer_id" widget="many2many_tags" readonly="1"/>
                <field name="branch_receipt_id" widget="many2many_tags" readonly="1"/>
                <field name="branch_production_id" widget="many2many_tags" readonly="1"/>
                <field name="return_transfer_id" widget="many2many_tags" readonly="1"/>
                <field name="final_receipt_id" widget="many2many_tags" readonly="1"/>
                <field name="total_qty_received" readonly="1"/>
            </xpath>

            <!-- Medidas (após user_id) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <group string="Medidas">
                    <field name="related_type"/>
                    <group>
                        <field name="blue_I"/>
                        <field name="blue_II"/>
                        <field name="blue_h"/>
                    </group>
                    <group>
                        <field name="blue_I_uom"/>
                        <field name="blue_II_uom"/>
                        <field name="blue_h_uom"/>
                    </group>
                    <group>
                        <field name="blue_advance"/>
                    </group>
                    <group>
                        <field name="blue_advance_uom"/>
                    </group>
                    <group>
                        <field name="blue_m2"/>
                        <field name="blue_m3"/>
                    </group>
                </group>
            </xpath>

            <!-- Aba adicional: Consumo em Filiais -->
            <xpath expr="//notebook/page[@name='components']" position="after">
                <page string="Consumo em Filiais" name="branch_consumption_page">
                    <field name="component_moves_branch_ids" colspan="4">
                        <tree editable="false">
                            <field name="product_id"/>
                            <field name="product_uom_qty" readonly="1" string="Qty Planejada"/>
                            <field name="quantity_done" string="Consumido"/>
                            <field name="location_id"/>
                            <field name="state" invisible="1"/>
                        </tree>
                    </field>

                    <group colspan="4">
                        <div class="o_form_field_text">
                            <p>
                                Estes registros representam o consumo REAL realizado nas filiais.
                                Não alteram estoque da matriz e não fazem parte da Lista de Materiais.
                            </p>
                        </div>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- VIEW PICKING — controle de campos invisíveis e botão validate -->
<record id="mrp_cut_picking_form_flow_control" model="ir.ui.view">
    <field name="name">stock.picking.form.flow.control</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">


        <!-- Campos invisíveis para controle -->
        <xpath expr="//form" position="inside">
            <field name="origin_production_id" invisible="1"/>
            <field name="custom_block_validate" invisible="1"/>
            <field name="show_validate" invisible="1"/>
            <field name="picking_type_code" invisible="1"/>
            <field name="branch_mo_id" invisible="1"/>
        </xpath>

        <page name="detailed_operations" position="before">
            <page name="operations" position="move"/>
        </page>

        <!-- Adicionar campos do pedido de venda e cliente NO LOCAL CORRETO -->
        <xpath expr="//field[@name='location_id']" position="after">
            <field name="sale_id" string="Pedido de Venda" readonly="1"/>
            <field name="customer" string="Cliente" readonly="1"/>
        </xpath>

        <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='description_picking']" position="replace">

        </xpath>
        <!-- Para move_ids_without_package (stock.move) - MOSTRAR descrição da linha de venda -->
        <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
            <field name="description_picking" readonly="1"/>
        </xpath>

        <!-- Botão validate condicional -->
        <button name="button_validate" position="attributes">
            <attribute name="attrs">{'invisible':[('show_validate','=',False)]}</attribute>
        </button>

    </field>
</record>


    <!-- List view small tweak -->
    <record id="mrp_cut_production_tree" model="ir.ui.view">
        <field name="name">mrp.production.cut.production.tree</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="message_state"/>
            </field>
        </field>
    </record>

</odoo>