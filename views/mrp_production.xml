<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_cut_production_inherit" model="ir.ui.view">
        <field name="name">mrp.cut.production.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- CAMPO TÉCNICO -->
            <xpath expr="//form/header" position="inside">
                <field name="has_child_production" invisible="1"/>
            </xpath>

            <!-- RELACIONAMENTOS -->
            <xpath expr="//field[@name='user_id']" position="after">
                <group string="Relacionamentos">

                    <group>
                        <field name="cut_plan_id" readonly="1"/>
                        <field name="parent_production_id"
                               readonly="1"
                               attrs="{'invisible': [('parent_production_id', '=', False)]}"/>
                    </group>

                    <group attrs="{'invisible': [('child_production_ids', '=', [])]}">
                        <field name="child_production_ids" readonly="1"/>
                    </group>

                </group>
            </xpath>

            <!-- MEDIDAS -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Medidas">
                    <group>
                        <field name="blue_m2" readonly="1"/>
                        <field name="blue_m3" readonly="1"/>
                    </group>
                </page>
            </xpath>


            <!-- BLOQUEIO DE EDIÇÃO -->
            <xpath expr="//field[@name='move_raw_ids']" position="attributes">
                <attribute name="attrs">
                    {'readonly': [('has_child_production', '=', True)]}
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>
