<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="mrp_production_inherit" model="ir.ui.view">
        <field name="name">mrp.production.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <button name="button_mark_done" position="attributes">
            <attribute name="string" condition="related_type == 'm' and state in ['confirmed','progress']">Enviar para Filial</attribute>
            <attribute name="string" condition="related_type != 'm' or branch_location_id or state not in ['confirmed','progress']">Concluir</attribute>
        </button>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="open_linked_po" attrs="{'invisible': [('count_po', '=', 0)]}"
                        type="object" icon="fa-flask">
                    <div class="o_stat_info">
                        <field name="count_po" nolabel="1" widget="statinfo"/>
                        <span class="o_stat_text">Plano De Corte</span>
                    </div>
                </button>
            </xpath>

             <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_create_branch_production" type="object"
                        string="Criar OP na Filial" class="oe_stat_button"
                        attrs="{'invisible': [('branch_receipt_id', '=', False)]}">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">OP Filial</span>
                    </div>
                </button>

                <button name="action_create_return_flow" type="object"
                        string="Criar Retorno" class="oe_stat_button"
                        attrs="{'invisible': [('branch_production_id', '=', False)]}">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Retorno</span>
                    </div>
                </button>

                <button name="action_finalize_production" type="object"
                        string="Concluir OP" class="oe_stat_button"
                        attrs="{'invisible': [('final_receipt_id', '=', False)]}">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Finalizar</span>
                    </div>
                </button>
            </xpath>

            <!-- Mensagem de alerta após o campo state -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="is_waiting_return" invisible="1"/>
                <div class="alert alert-warning" attrs="{'invisible': [('is_waiting_return', '=', False)]}">
                    <i class="fa fa-info-circle"/> Aguardando retorno do processamento na filial.
                </div>
            </xpath>

            <!-- Seção do fluxo filial no final do sheet -->
            <xpath expr="//sheet" position="before">
                <group string="Fluxo Filial" attrs="{'invisible': [('branch_location_id', '=', False)]}">
                    <group>
                        <group>
                            <field name="branch_location_id" readonly="1"/>
                            <field name="sending_transfer_id" readonly="1"/>
                            <field name="branch_receipt_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="branch_production_id" readonly="1"/>
                            <field name="return_transfer_id" readonly="1"/>
                            <field name="final_receipt_id" readonly="1"/>
                        </group>
                    </group>
                </group>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="after">
                <group string="Medidas">
                    <field name="related_type" string="Tipo"/>
                    <group>
                        <field name="blue_I" string="L"/>
                        <field name="blue_II" string="L "/>
                        <field name="blue_advance" string="Avanço"/>
                    </group>
                    <group>
                        <field name="blue_I_uom" string="Udm L"/>
                        <field name="blue_II_uom" string="Udm L "/>
                        <field name="blue_advance_uom" string="Udm Avanço"/>

                    </group>

                    <group>
                        <field name="blue_h" string="H"/>

                    </group>
                    <group>
                        <field name="blue_h_uom" string="Udm H"/>
                    </group>


                </group>
            </xpath>

        </field>
    </record>


</odoo>
