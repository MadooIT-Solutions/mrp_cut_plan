<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VIEW PICKING — controle de campos invisíveis e botão validate -->
    <record id="mrp_cut_picking_form_flow_control" model="ir.ui.view">
        <field name="name">stock.picking.form.flow.control</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">


            <!-- Campos invisíveis para controle -->
            <xpath expr="//form" position="inside">
                <field name="custom_block_validate" invisible="1"/>
                <field name="show_validate" invisible="1"/>
                <field name="picking_type_code" invisible="1"/>
                <field name="branch_mo_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="attributes">
                <attribute name="attrs">{'readonly': ['|', ('is_initial_demand_editable', '=', False), '&amp;', '&amp;', ('show_operations', '=', True), ('is_locked', '=', True), ('is_initial_demand_editable', '=', False)]}</attribute>
            </xpath>
            <page name="detailed_operations" position="before">
                <page name="operations" position="move"/>
            </page>

            <!-- Adicionar campos do pedido de venda e cliente NO LOCAL CORRETO -->
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="sale_id" string="Pedido de Venda" readonly="1"/>
                <field name="customer" string="Cliente" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='description_picking']" position="replace">

            </xpath>
            <!-- Para move_ids_without_package (stock.move) - MOSTRAR descrição da linha de venda -->
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']" position="after">
                <field name="description_picking" readonly="1"/>
            </xpath>




            <!-- Botão validate condicional -->
            <!--            <button name="button_validate" position="attributes">-->
            <!--                <attribute name="attrs">{'invisible':[('show_validate','=',False)]}</attribute>-->
            <!--            </button>-->

        </field>
    </record>

    <record id="view_picking_form_hide_forecast_when_produced" model="ir.ui.view">
        <field name="name">stock.picking.form.hide.forecast.produced</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_ids_without_package']/tree" position="inside">
                <field name="is_produced_status"
                       widget="badge"
                       decoration-success="is_produced_status == 'yes'"
                       decoration-info="is_produced_status == 'started','confirmed'"
                       decoration-danger="is_produced_status == 'no'"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/tree"
                   position="attributes">
                <attribute name="decoration-success">is_produced_status == 'yes'</attribute>
                <attribute name="decoration-info">is_produced_status == 'confirmed'</attribute>
                <attribute name="decoration-info">is_produced_status == 'started'</attribute>
                <attribute name="decoration-danger">is_produced_status == 'no'</attribute>
            </xpath>


            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='forecast_availability']"
                   position="attributes">
                <attribute name="attrs">{'invisible': [('is_produced_status', 'in', ('yes','started'))]}</attribute>
            </xpath>


        </field>
    </record>

    <record id="view_picking_form_production_status_badge" model="ir.ui.view">
        <field name="name">stock.picking.form.production.status.badge</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Insere status no cabeçalho -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="production_status"
                       widget="badge"
                       decoration-danger="production_status == 'not_started'"
                       decoration-warning="production_status in ('started_partial', 'partial')"
                       decoration-info="production_status == 'started'"
                       decoration-success="production_status == 'ready'"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_picking_tree_production_status_badge" model="ir.ui.view">
    <field name="name">stock.picking.tree.production.status.badge</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.vpicktree"/>
    <field name="arch" type="xml">

        <!-- Inserir antes do campo Status -->
        <xpath expr="//field[@name='state']" position="before">
            <field name="production_status"
                   widget="badge"
                   decoration-danger="production_status == 'not_started'"
                   decoration-warning="production_status in ('started_partial', 'partial')"
                   decoration-info="production_status == 'started'"
                   decoration-success="production_status == 'ready'"/>
        </xpath>

    </field>
</record>


</odoo>